name: 'NoXoR'
on: workflow_dispatch
jobs:
  build:
    uses: ./.github/workflows/main.yml
    secrets: inherit
    with:
      board: '["nice_nano_v2"]'
      shield: '["corne_left nice_view_adapter nice_view_gem", "corne_right nice_view_adapter nice_view_gem"]'
      alphas: '["COLEMAK"]'
      clipboard: '["Windows"]'
      kconfig: '["CONFIG_ZMK_SLEEP=y\nCONFIG_ZMK_DISPLAY=y\nCONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y\nCONFIG_ZMK_DISPLAY_WORK_QUEUE_DEDICATED=y'\nCONFIG_ZMK_KEYBOARD_NAME=\\\"NoXoR\\\"\nCONFIG_BT_CTLR_TX_PWR_PLUS_8=y\nCONFIG_ZMK_BLE_EXPERIMENTAL_FEATURES=y\nCONFIG_ZMK_BLE_PASSKEY_ENTRY=y"]'
      layers: '["default"]'
      mapping: '["default"]'
      nav: '["default"]'
      custom_config: '["#define MIRYOKU_ALPHAS_COLEMAK\n#define MIRYOKU_TAP_COLEMAK\n#define MIRYOKU_EXTRA_COLEMAK\n#define MIRYOKU_CLIPBOARD_WIN"]'
      branches: '["default"]'
      modules: '["M165437/nice-view-gem/main"]'
